{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/memory.schema.json",
  "title": "MAG Memory Record",
  "type": "object",
  "required": [
    "memory_id",
    "user_id",
    "memory_type",
    "memory_key",
    "content",
    "status",
    "version",
    "valid_from",
    "expires_at"
  ],
  "properties": {
    "memory_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "memory_type": {
      "enum": [
        "TICKET_REFERENCE",
        "SUPPORT_SUMMARY",
        "SUPPORT_PREFERENCE"
      ]
    },
    "memory_key": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "ticket_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "EXPIRED",
        "DELETED"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "source_turn_id": {
      "type": "string"
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": false
}
